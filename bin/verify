#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> prettier"
pnpm exec prettier --check .

echo "==> eslint"
pnpm exec eslint

echo "==> tsc"
pnpm exec tsc --noEmit

echo "==> vitest"
pnpm exec vitest run

echo "==> playwright"
pnpm exec playwright test

echo "==> next build"
pnpm exec next build
